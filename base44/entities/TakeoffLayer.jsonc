{
  "name": "TakeoffLayer",
  "type": "object",
  "properties": {
    "takeoff_id": {
      "type": "string",
      "title": "Takeoff",
      "relation": "Takeoff"
    },
    "name": {
      "type": "string",
      "title": "Layer Name"
    },
    "color": {
      "type": "string",
      "title": "Color",
      "default": "#3b82f6"
    },
    "visible": {
      "type": "boolean",
      "title": "Visible",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "takeoff_id",
    "name"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}