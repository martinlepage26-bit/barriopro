{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project",
      "relation": "Project"
    },
    "action": {
      "type": "string",
      "title": "Action"
    },
    "details": {
      "type": "string",
      "title": "Details"
    },
    "user_name": {
      "type": "string",
      "title": "User"
    }
  },
  "required": [
    "project_id",
    "action"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}