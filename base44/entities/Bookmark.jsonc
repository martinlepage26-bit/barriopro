{
  "name": "Bookmark",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project",
      "relation": "Project"
    },
    "document_id": {
      "type": "string",
      "title": "Document",
      "relation": "Document"
    },
    "page_number": {
      "type": "number",
      "default": 1,
      "title": "Page Number"
    },
    "note": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "project_id",
    "note"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}