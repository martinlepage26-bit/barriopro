{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Project Name"
    },
    "customer": {
      "type": "string",
      "title": "Customer"
    },
    "address": {
      "type": "string",
      "title": "Project Address"
    },
    "bid_date": {
      "type": "string",
      "format": "date",
      "title": "Bid Due Date"
    },
    "project_number": {
      "type": "string",
      "title": "Project Number"
    },
    "estimator": {
      "type": "string",
      "title": "Estimator"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Estimating",
        "Quote Ready",
        "Submitted",
        "Won",
        "Lost",
        "Archived"
      ],
      "default": "New",
      "title": "Status"
    },
    "estimated_value": {
      "type": "number",
      "title": "Estimated Value"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}