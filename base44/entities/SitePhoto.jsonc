{
  "name": "SitePhoto",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project",
      "relation": "Project"
    },
    "fence_segment_id": {
      "type": "string",
      "title": "Fence Segment",
      "relation": "FenceSegment"
    },
    "photo_url": {
      "type": "string",
      "format": "file",
      "title": "Photo"
    },
    "caption": {
      "type": "string",
      "title": "Caption"
    }
  },
  "required": [
    "project_id",
    "photo_url"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}